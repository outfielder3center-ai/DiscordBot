{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron?type=morning",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron?type=evening",
      "schedule": "0 11 * * *"
    }
  ]
}